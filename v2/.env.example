# Copier en .env — JAMAIS committé. Le .gitignore l'exclut explicitement.
#
# Ce fichier existe parce que la v1 n'en avait pas : le mot de passe Azure SQL,
# la clé du compte de stockage et la clé secrète Stripe vivaient dans
# application.properties, donc dans l'historique git, depuis février 2025.

# --- base de données ---
DB_URL=jdbc:postgresql://localhost:6432/ensimasso
DB_USER=ensimasso
DB_PASSWORD=changez_moi
DB_RO_USER=ensimasso_ro
DB_RO_PASSWORD=changez_moi
DB_POOL_MAX=10

# --- identité ---
OIDC_ISSUER=http://localhost:8081/realms/ensimasso
KEYCLOAK_ADMIN_PASSWORD=changez_moi

# --- stockage objet ---
MINIO_USER=ensimasso
MINIO_PASSWORD=changez_moi_12_caracteres
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_ORIGINAUX=media-originaux

# --- paiement ---
# Sans ces deux valeurs, l'application REFUSE de démarrer. C'est voulu : avec un
# secret de webhook vide, Stripe encaisse et aucune adhésion ne s'active — une
# panne qui ne se voit ni au démarrage ni à l'achat, seulement à la réclamation.
# En développement, n'importe quelle valeur non vide suffit tant qu'aucun
# paiement réel n'est tenté ; les clés de test viennent du tableau de bord
# Stripe (elles commencent par sk_test_ et whsec_).
STRIPE_CLE_SECRETE=sk_test_changez_moi
STRIPE_SECRET_WEBHOOK=whsec_changez_moi

# --- recherche ---
MEILI_KEY=changez_moi

# --- évènements ---

# --- divers ---
LOG_LEVEL=INFO
PORT=8080
