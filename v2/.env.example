# Copier en .env — JAMAIS committé. Le .gitignore l'exclut explicitement.
#
# Ce fichier existe parce que la v1 n'en avait pas : le mot de passe Azure SQL,
# la clé du compte de stockage et la clé secrète Stripe vivaient dans
# application.properties, donc dans l'historique git, depuis février 2025.

# --- base de données ---
DB_URL=jdbc:postgresql://localhost:6432/ensimasso
DB_USER=ensimasso
DB_PASSWORD=changez_moi
DB_RO_USER=ensimasso_ro
DB_RO_PASSWORD=changez_moi
DB_POOL_MAX=10

# --- identité ---
OIDC_ISSUER=http://localhost:8081/realms/ensimasso
KEYCLOAK_ADMIN_PASSWORD=changez_moi

# --- stockage objet ---
MINIO_USER=ensimasso
MINIO_PASSWORD=changez_moi_12_caracteres
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_ORIGINAUX=media-originaux
MINIO_BUCKET_VARIANTES=media-variantes

# --- recherche ---
MEILI_KEY=changez_moi

# --- évènements ---
KAFKA_BOOTSTRAP=localhost:9092

# --- divers ---
LOG_LEVEL=INFO
PORT=8080
